{
  "name": "artcode-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ArtCode local desktop application",
  "author": "ArtCode",
  "main": "electron/main.cjs",
  "scripts": {
    "test:commands": "node scripts/test-command-feedback.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dev": "vite --host 127.0.0.1",
    "backend:build": "node scripts/build-backend.cjs",
    "package": "npm run build && npm run backend:build && electron-builder --mac dir"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.artcode.desktop",
    "productName": "ArtCode",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{"from": "backend/artcode-server", "to": "backend"}],
    "mac": {"category": "public.app-category.developer-tools", "identity": null}
  }
}
